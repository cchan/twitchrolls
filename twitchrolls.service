[Unit]
Description=twitchrolls.clive.io service
After=network.target twitchrolls-build.service
Requires=twitchrolls-build.service
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=1
User=www
WorkingDirectory=/home/www/go/src/github.com/cchan/twitchrolls
ExecStart=/home/www/bin/twitchrolls

[Install]
WantedBy=multi-user.target
